# Copy to .env and fill in as needed:  cp .env.example .env
# NEVER commit the real .env file (it's already in .gitignore) — this file ships
# with placeholders/safe defaults only.
#
# docker-compose.yml loads this file via `env_file: .env` for the backend service,
# then overrides DATABASE_URL / OLLAMA_BASE_URL / FRONTEND_ORIGIN itself so the
# containers can reach each other by service name — the values below for those
# three are what apply when running the backend natively (§8 in README.md), not
# inside Docker Compose.

# ============================================================================
# App — OPTIONAL (sensible defaults for local use)
# ============================================================================
ENV=development
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# OPTIONAL — override if the default ports conflict with something else already
# running on your machine. docker-compose.yml uses these for both the host port
# mapping AND to derive FRONTEND_ORIGIN/NEXT_PUBLIC_API_URL, so CORS always
# matches wherever the frontend actually ends up — you only need to set these two,
# not FRONTEND_ORIGIN separately.
# FRONTEND_PORT=3002
# BACKEND_PORT=8000

# OPTIONAL — frontend build-time var (NEXT_PUBLIC_* is bundled into the browser
# bundle, so only ever put non-secret, client-safe values here — never a key).
# Where the browser should reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# Database — REQUIRED (a value is required; the default below matches
# docker-compose.yml's `db` service and needs no changes for the Docker path)
# ============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant

# ============================================================================
# LLM providers
# ============================================================================
# OPTIONAL — which provider new chats default to. "ollama" requires no API key
# and is the assignment's mandatory demo path; the app runs fully on Ollama alone
# with everything below left blank.
DEFAULT_LLM_PROVIDER=ollama

# OPTIONAL — Ollama connection. Defaults assume the `ollama` container from
# docker-compose.yml; set to http://host.docker.internal:11434 if you're running
# Ollama natively on your host instead (see README §5).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# OPTIONAL — leave ANTHROPIC_API_KEY blank to run Ollama-only. The UI shows the
# Claude toggle as unavailable (not broken) when this is unset — never required.
# This is a server-side secret: it is read only by the backend and is NEVER
# passed to the frontend or any NEXT_PUBLIC_* variable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# Embeddings — OPTIONAL (defaults work out of the box, no key required either way)
# ============================================================================
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=384

# ============================================================================
# RAG tuning — OPTIONAL (defaults are reasonable starting points; see README §12)
# ============================================================================
RETRIEVAL_TOP_K=5
# Cosine similarity floor for all-MiniLM-L6-v2 embeddings. Kept at 0.35 —
# confirmed via a live diagnostic against the real corpus that raising this
# alone doesn't fix weak retrieval; the real fix is a wider candidate pool
# before filtering (RETRIEVAL_CANDIDATE_POOL below), not a stricter floor.
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
# After the floor above, drop any chunk scoring more than this far below the
# single best match — keeps a strong match from being diluted by weaker
# also-rans. Raise toward 1.0 to disable (keep everything above the floor).
RETRIEVAL_RELATIVE_MARGIN=0.15
# How many nearest-neighbor candidates are fetched from pgvector BEFORE the
# threshold/margin filters above run — always >= RETRIEVAL_TOP_K, since the
# final result is still capped at RETRIEVAL_TOP_K after filtering. Widening
# this gives the filters more candidates to actually find a relevant chunk
# among, instead of only ever considering the top few by raw vector distance.
RETRIEVAL_CANDIDATE_POOL=15
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_TOKENS=100

# OPTIONAL — target word count for the Ship 30 for 30 skill.
SHIP30_TARGET_WORDS=1250
